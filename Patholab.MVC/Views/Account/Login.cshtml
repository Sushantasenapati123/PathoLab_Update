@model Patholab.Shared.DTOs.LoginRequest
@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Login - Patholab Diagnostic System</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&family=Outfit:wght@600;700&display=swap" rel="stylesheet">

    <style>
        body {
            font-family: 'Inter', sans-serif;
            background: radial-gradient(circle at 10% 20%, rgb(0, 95, 189) 0%, rgb(0, 4, 38) 90%);
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 20px;
            color: #f8fafc;
        }

        .login-container {
            width: 100%;
            max-width: 950px;
            background: rgba(255, 255, 255, 0.04);
            backdrop-filter: blur(16px);
            border: 1px solid rgba(255, 255, 255, 0.08);
            border-radius: 20px;
            overflow: hidden;
            box-shadow: 0 20px 40px rgba(0, 0, 0, 0.3);
        }

        .brand-panel {
            background: linear-gradient(135deg, rgba(14, 165, 233, 0.95), rgba(37, 99, 235, 0.95));
            padding: 45px;
            display: flex;
            flex-direction: column;
            justify-content: center;
            align-items: center;
            text-align: center;
        }

        .brand-panel i {
            font-size: 70px;
            margin-bottom: 20px;
            animation: pulse 3s infinite;
        }

        .brand-title {
            font-family: 'Outfit', sans-serif;
            font-size: 32px;
            font-weight: 700;
            letter-spacing: 0.5px;
            margin-bottom: 10px;
        }

        .login-form-panel {
            padding: 45px;
            background-color: rgba(15, 23, 42, 0.85);
        }

        .form-title {
            font-family: 'Outfit', sans-serif;
            font-size: 24px;
            font-weight: 700;
            color: white;
            margin-bottom: 25px;
        }

        .input-group-custom {
            background: rgba(255, 255, 255, 0.05);
            border: 1px solid rgba(255, 255, 255, 0.1);
            border-radius: 8px;
            padding: 5px 15px;
            margin-bottom: 20px;
            display: flex;
            align-items: center;
            gap: 12px;
            transition: all 0.2s;
        }

        .input-group-custom:focus-within {
            border-color: #38bdf8;
            background: rgba(255, 255, 255, 0.08);
            box-shadow: 0 0 0 2px rgba(56, 189, 248, 0.2);
        }

        .input-group-custom i {
            color: #94a3b8;
            font-size: 16px;
        }

        .input-group-custom input {
            background: none;
            border: none;
            color: white;
            width: 100%;
            padding: 8px 0;
            font-size: 14px;
        }

        .input-group-custom input:focus {
            outline: none;
        }

        .btn-login {
            background: linear-gradient(135deg, #0ea5e9, #2563eb);
            border: none;
            color: white;
            width: 100%;
            padding: 12px;
            font-weight: 600;
            font-size: 15px;
            border-radius: 8px;
            margin-top: 10px;
            box-shadow: 0 4px 12px rgba(14, 165, 233, 0.3);
            transition: all 0.2s;
        }

        .btn-login:hover {
            background: linear-gradient(135deg, #0284c7, #1d4ed8);
            transform: translateY(-1px);
            box-shadow: 0 6px 16px rgba(14, 165, 233, 0.4);
        }

        .credential-tag {
            font-size: 11px;
            background-color: rgba(255, 255, 255, 0.08);
            color: #e2e8f0;
            padding: 4px 8px;
            border-radius: 4px;
            cursor: pointer;
            transition: all 0.1s;
        }

        .credential-tag:hover {
            background-color: #38bdf8;
            color: #0f172a;
        }

        @@keyframes pulse {
            0% { transform: scale(1); }
            50% { transform: scale(1.05); }
            100% { transform: scale(1); }
        }

        @@media (max-width: 768px) {
            .brand-panel {
                padding: 30px;
            }
            .login-form-panel {
                padding: 30px;
            }
        }
    </style>
</head>
<body>

    <div class="login-container">
        <div class="row g-0">
            <!-- BRANDING -->
            <div class="col-md-5 brand-panel text-white">
                <i class="fa-solid fa-microscope"></i>
                <h2 class="brand-title">Patholab System</h2>
                <p class="text-white-50 m-0" style="font-size: 13.5px; line-height: 1.6;">
                    Enterprise Laboratory Information Management System. Automating diagnostics workflows from specimen registrations to pathologists digital sign-offs.
                </p>
            </div>

            <!-- LOGIN FIELDS -->
            <div class="col-md-7 login-form-panel">
                <h3 class="form-title text-center text-md-start">Staff Access Portal</h3>

                <form asp-action="Login" method="post" id="loginForm">
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 border-0" style="font-size: 13px; background-color: rgba(239, 68, 68, 0.15); color: #f87171;"></div>

                    <div class="input-group-custom">
                        <i class="fa-solid fa-user-shield"></i>
                        <input asp-for="Username" type="text" placeholder="Enter username" required id="txtUsername" />
                    </div>
                    <span asp-validation-for="Username" class="text-danger d-block mb-3" style="font-size: 12px;"></span>

                    <div class="input-group-custom">
                        <i class="fa-solid fa-key"></i>
                        <input asp-for="Password" type="password" placeholder="Enter security password" required id="txtPassword" />
                    </div>
                    <span asp-validation-for="Password" class="text-danger d-block mb-3" style="font-size: 12px;"></span>

                    <button type="submit" class="btn-login">Verify Credentials & Sign In</button>
                </form>

                <!-- Seeded Account Hints -->
                <div class="mt-4 pt-3 border-top border-secondary">
                    <div class="text-muted mb-2" style="font-size: 11px; font-weight: 600; text-transform: uppercase; letter-spacing: 0.5px;">Seeded accounts (Click to fill)</div>
                    <div class="d-flex flex-wrap gap-2">
                        <span class="credential-tag" onclick="fillCreds('admin', 'Admin@123')">Admin</span>
                        <span class="credential-tag" onclick="fillCreds('reception', 'Reception@123')">Receptionist</span>
                        <span class="credential-tag" onclick="fillCreds('technician', 'Technician@123')">Technician</span>
                        <span class="credential-tag" onclick="fillCreds('pathologist', 'Pathologist@123')">Pathologist</span>
                        <span class="credential-tag" onclick="fillCreds('accountant', 'Accountant@123')">Accountant</span>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script>
        function fillCreds(user, pass) {
            $('#txtUsername').val(user);
            $('#txtPassword').val(pass);
        }
    </script>
</body>
</html>
