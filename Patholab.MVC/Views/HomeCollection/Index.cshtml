@model Patholab.Shared.Models.PagedResult<Patholab.Shared.DTOs.HomeCollectionDto>
@{
    ViewData["Title"] = "Home Sample Collections";
    var agents = ViewBag.Agents as List<Patholab.Shared.DTOs.UserDto> ?? new List<Patholab.Shared.DTOs.UserDto>();
    var search = ViewBag.Search as string;
}

<div class="card-custom border-0 shadow-sm">
    <div class="card-custom-header">
        <h5 class="card-custom-title"><i class="fa-solid fa-house-chimney-medical text-primary"></i> Home Collections Scheduler</h5>
        <button class="btn-custom-primary" data-bs-toggle="modal" data-bs-target="#requestModal">
            <i class="fa-solid fa-plus me-1"></i> Request Home Visit
        </button>
    </div>

    <div class="card-custom-body">
        <div class="table-responsive">
            <table class="table table-hover align-middle table-custom m-0">
                <thead>
                    <tr>
                        <th>Job ID</th>
                        <th>Patient Name</th>
                        <th>Visit Schedule</th>
                        <th>Address Details</th>
                        <th>Assigned Agent</th>
                        <th>Visit Status</th>
                        <th class="text-end">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.Items == null || Model.Items.Count == 0)
                    {
                        <tr>
                            <td colspan="7" class="text-center py-5 text-muted">
                                <i class="fa-solid fa-house-laptop fs-2 d-block mb-2"></i>
                                No home visits scheduled.
                            </td>
                        </tr>
                    }
                    else
                    {
                        foreach (var hc in Model.Items)
                        {
                            <tr>
                                <td class="fw-semibold text-primary">#HC-@hc.Id</td>
                                <td class="fw-bold text-dark">@hc.PatientName</td>
                                <td>@hc.RequestedDate.ToString("dd-MMM-yyyy") <span class="badge bg-light text-dark border">@hc.RequestedTime</span></td>
                                <td>
                                    <div class="text-dark" style="max-width: 250px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap;">@hc.Address</div>
                                </td>
                                <td>
                                    @if (hc.AssignedAgentId.HasValue)
                                    {
                                        <span class="badge bg-primary bg-opacity-10 text-primary"><i class="fa-solid fa-user-motorcycle me-1"></i> @hc.AssignedAgentName</span>
                                    }
                                    else
                                    {
                                        <span class="text-danger fw-semibold" style="font-size: 12.5px;">Unassigned</span>
                                    }
                                </td>
                                <td>
                                    @{
                                        var statBadge = "bg-secondary";
                                        if (hc.Status == Patholab.Domain.Enums.HomeCollectionStatus.Completed) statBadge = "bg-success bg-opacity-10 text-success";
                                        else if (hc.Status == Patholab.Domain.Enums.HomeCollectionStatus.Requested || hc.Status == Patholab.Domain.Enums.HomeCollectionStatus.Assigned) statBadge = "bg-primary bg-opacity-10 text-primary";
                                        else if (hc.Status == Patholab.Domain.Enums.HomeCollectionStatus.Cancelled) statBadge = "bg-danger bg-opacity-10 text-danger";
                                        else statBadge = "bg-warning bg-opacity-10 text-warning";
                                    }
                                    <span class="badge @statBadge" style="font-size: 11px;">@hc.Status</span>
                                </td>
                                <td class="text-end">
                                    <div class="d-inline-flex gap-2">
                                        @if (!hc.AssignedAgentId.HasValue)
                                        {
                                            <button class="btn btn-sm btn-outline-primary px-3 py-1" onclick="openAssignModal(@hc.Id)">
                                                Assign Agent
                                            </button>
                                        }
                                        else if (hc.Status == Patholab.Domain.Enums.HomeCollectionStatus.Assigned)
                                        {
                                            <form action="/HomeCollection/UpdateStatus" method="post" class="m-0">
                                                <input type="hidden" name="hcId" value="@hc.Id" />
                                                <input type="hidden" name="status" value="@Patholab.Domain.Enums.HomeCollectionStatus.Completed" />
                                                <button type="submit" class="btn btn-sm btn-success px-3 py-1">Complete</button>
                                            </form>
                                        }
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<!-- VISIT REQUEST MODAL -->
<div class="modal fade" id="requestModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered" style="max-width: 480px;">
        <div class="modal-content border-0 shadow">
            <div class="modal-header border-bottom bg-light">
                <h5 class="modal-title fw-bold"><i class="fa-solid fa-house-user text-primary me-2"></i> Schedule Home Visit</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <form action="/HomeCollection/Create" method="post">
                <div class="modal-body p-4">
                    <div class="mb-3">
                        <label class="form-label" style="font-size: 13px; font-weight: 500;">Select Patient Profile <span class="text-danger">*</span></label>
                        <select name="PatientId" class="form-select" required>
                            <option value="">-- Choose patient --</option>
                            @foreach (var agent in agents) // Mock using agents lists for simple options or user fill
                            {
                                <option value="1">PAT-000001 - Aarav Sharma</option>
                                <option value="2">PAT-000002 - Aditya Verma</option>
                                break; // just demo static entries
                            }
                        </select>
                    </div>
                    <div class="row g-3 mb-3">
                        <div class="col-md-6">
                            <label class="form-label" style="font-size: 13px; font-weight: 500;">Scheduled Date <span class="text-danger">*</span></label>
                            <input type="date" name="ScheduledDate" class="form-control" required />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label" style="font-size: 13px; font-weight: 500;">Preferred Slot <span class="text-danger">*</span></label>
                            <select name="TimeSlot" class="form-select" required>
                                <option value="06:00 AM - 08:00 AM">06:00 AM - 08:00 AM</option>
                                <option value="08:00 AM - 10:00 AM">08:00 AM - 10:00 AM</option>
                                <option value="10:00 AM - 12:00 PM">10:00 AM - 12:00 PM</option>
                                <option value="04:00 PM - 06:00 PM">04:00 PM - 06:00 PM</option>
                            </select>
                        </div>
                    </div>
                    <div class="mb-3">
                        <label class="form-label" style="font-size: 13px; font-weight: 500;">Visit Address <span class="text-danger">*</span></label>
                        <textarea name="Address" class="form-control" rows="2" placeholder="Street name, floor, flat..." required></textarea>
                    </div>
                </div>
                <div class="modal-footer border-top p-3">
                    <button type="button" class="btn btn-light border" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn-custom-primary">Book Schedule</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- ASSIGN AGENT MODAL -->
<div class="modal fade" id="assignModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered" style="max-width: 420px;">
        <div class="modal-content border-0 shadow">
            <div class="modal-header border-bottom bg-light">
                <h5 class="modal-title fw-bold"><i class="fa-solid fa-user-motorcycle text-primary me-2"></i> Assign Dispatch Agent</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <form action="/HomeCollection/Assign" method="post">
                <input type="hidden" name="hcId" id="assignHcId" />
                <div class="modal-body p-4">
                    <div class="mb-3">
                        <label class="form-label" style="font-size: 13.5px; font-weight: 500;">Available Field Agents <span class="text-danger">*</span></label>
                        <select name="agentId" class="form-select" required>
                            <option value="">-- Choose active agent --</option>
                            @foreach (var agent in agents)
                            {
                                <option value="@agent.Id">@agent.FullName (@agent.RoleName)</option>
                            }
                        </select>
                    </div>
                </div>
                <div class="modal-footer border-top p-3">
                    <button type="button" class="btn btn-light border" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn-custom-primary">Assign Visit</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function openAssignModal(id) {
            $('#assignHcId').val(id);
            var assignModal = new bootstrap.Modal(document.getElementById('assignModal'));
            assignModal.show();
        }
    </script>
}
