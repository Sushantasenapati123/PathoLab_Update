@model Patholab.Shared.Models.PagedResult<Patholab.Shared.DTOs.SampleDto>
@{
    ViewData["Title"] = "Specimen Registry Workstation";
    var search = ViewBag.Search as string;
}

<div class="card-custom border-0 shadow-sm">
    <div class="card-custom-header">
        <h5 class="card-custom-title"><i class="fa-solid fa-vials text-primary"></i> Specimen Workstation Queue</h5>
    </div>

    <div class="card-custom-body">
        <!-- Search filter form -->
        <form action="/Laboratory/Samples" method="get" class="mb-4">
            <div class="row g-2">
                <div class="col-md-5">
                    <div class="input-group">
                        <span class="input-group-text bg-white border-end-0 text-muted"><i class="fa-solid fa-magnifying-glass"></i></span>
                        <input type="text" name="search" class="form-control border-start-0 ps-0" placeholder="Search by Sample #, Barcode, or Order #..." value="@search" />
                    </div>
                </div>
                <div class="col-md-2">
                    <button type="submit" class="btn btn-light border w-100">Filter Queue</button>
                </div>
                @if (!string.IsNullOrEmpty(search))
                {
                    <div class="col-md-2">
                        <a href="/Laboratory/Samples" class="btn btn-link text-muted">Clear Filters</a>
                    </div>
                }
            </div>
        </form>

        <div class="table-responsive">
            <table class="table table-hover align-middle table-custom m-0">
                <thead>
                    <tr>
                        <th>Sample Code</th>
                        <th>Order Ref</th>
                        <th>Patient Details</th>
                        <th>Specimen Type</th>
                        <th>Barcode ID</th>
                        <th>Dates & Stamps</th>
                        <th>Status</th>
                        <th class="text-end">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.Items == null || Model.Items.Count == 0)
                    {
                        <tr>
                            <td colspan="8" class="text-center py-5 text-muted">
                                <i class="fa-solid fa-vial-circle-check fs-2 d-block mb-2"></i>
                                No sample vials in collection queue.
                            </td>
                        </tr>
                    }
                    else
                    {
                        foreach (var s in Model.Items)
                        {
                            <tr>
                                <td class="fw-semibold text-primary">@s.SampleNumber</td>
                                <td class="fw-bold">@s.OrderNumber</td>
                                <td>
                                    <div class="fw-bold text-dark">@s.PatientName</div>
                                    <span class="text-muted" style="font-size: 11px;">ID: @s.PatientCode</span>
                                </td>
                                <td><span class="badge bg-light text-dark border"><i class="fa-solid fa-droplet text-danger me-1"></i> @s.SampleTypeName</span></td>
                                <td class="fw-semibold text-muted">@(string.IsNullOrEmpty(s.Barcode) ? "--" : s.Barcode)</td>
                                <td>
                                    @if (s.CollectionDateTime.HasValue)
                                    {
                                        <div style="font-size: 12px;"><i class="fa-solid fa-hand-holding-droplet me-1"></i> Coll: @s.CollectionDateTime.Value.ToString("dd-MMM hh:mm tt")</div>
                                    }
                                    @if (s.ReceivedDateTime.HasValue)
                                    {
                                        <div style="font-size: 12px;" class="text-success"><i class="fa-solid fa-house-chimney-medical me-1"></i> Recv: @s.ReceivedDateTime.Value.ToString("dd-MMM hh:mm tt")</div>
                                    }
                                </td>
                                <td>
                                    @{
                                        var badge = "bg-secondary";
                                        if (s.SampleStatus == Patholab.Domain.Enums.SampleStatus.Completed) badge = "bg-success bg-opacity-10 text-success";
                                        else if (s.SampleStatus == Patholab.Domain.Enums.SampleStatus.Collected) badge = "bg-warning bg-opacity-10 text-warning";
                                        else if (s.SampleStatus == Patholab.Domain.Enums.SampleStatus.Rejected) badge = "bg-danger bg-opacity-10 text-danger";
                                        else badge = "bg-primary bg-opacity-10 text-primary";
                                    }
                                    <span class="badge @badge" style="font-size: 11px;">@s.SampleStatus</span>
                                </td>
                                <td class="text-end">
                                    <div class="d-inline-flex gap-2">
                                        @if (s.SampleStatus == Patholab.Domain.Enums.SampleStatus.Pending)
                                        {
                                            <button class="btn btn-sm btn-custom-primary px-3 py-1" onclick="openCollectModal(@s.Id, '@s.SampleTypeName', '@s.OrderNumber')">
                                                <i class="fa-solid fa-barcode me-1"></i> Collect
                                            </button>
                                        }
                                        else if (s.SampleStatus == Patholab.Domain.Enums.SampleStatus.Collected)
                                        {
                                            <form action="/Laboratory/Receive" method="post" class="m-0">
                                                <input type="hidden" name="sampleId" value="@s.Id" />
                                                <button type="submit" class="btn btn-sm btn-success px-3 py-1">
                                                    <i class="fa-solid fa-clipboard-check me-1"></i> Lab Receipt
                                                </button>
                                            </form>
                                            <button class="btn btn-sm btn-outline-danger px-2 py-1" onclick="openRejectModal(@s.Id)">
                                                <i class="fa-solid fa-ban"></i> Reject
                                            </button>
                                        }
                                        else if (s.SampleStatus == Patholab.Domain.Enums.SampleStatus.Received || s.SampleStatus == Patholab.Domain.Enums.SampleStatus.Completed)
                                        {
                                            <a href="/Laboratory/ResultEntry?sampleId=@s.Id" class="btn btn-sm btn-light border px-3 py-1">
                                                <i class="fa-solid fa-flask text-muted me-1"></i> Enter Results
                                            </a>
                                        }
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<!-- COLLECT MODAL -->
<div class="modal fade" id="collectModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered" style="max-width: 450px;">
        <div class="modal-content border-0 shadow">
            <div class="modal-header border-bottom bg-light">
                <h5 class="modal-title fw-bold"><i class="fa-solid fa-barcode text-primary me-2"></i> Register Specimen Vial</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <form action="/Laboratory/Collect" method="post">
                <input type="hidden" name="sampleId" id="collectSampleId" />
                <div class="modal-body p-4">
                    <div class="mb-3">
                        <label class="form-label" style="font-size: 13.5px; font-weight: 500;">Specimen Vial Type</label>
                        <input type="text" class="form-control bg-light" id="collectVialType" readonly />
                    </div>
                    <div class="mb-3">
                        <label class="form-label" style="font-size: 13.5px; font-weight: 500;">Case Reference</label>
                        <input type="text" class="form-control bg-light" id="collectCaseRef" readonly />
                    </div>
                    <div class="mb-1">
                        <label class="form-label" style="font-size: 13.5px; font-weight: 500;">Assign Vial Barcode <span class="text-danger">*</span></label>
                        <input type="text" name="barcode" class="form-control fw-bold text-primary" placeholder="Scan or type barcode string..." required id="collectBarcodeVal" />
                        <span class="text-muted mt-2 d-block" style="font-size: 11px;">e.g. BAR-2026-00123. Tip: Barcode is printed and attached to the tube.</span>
                    </div>
                </div>
                <div class="modal-footer border-top p-3">
                    <button type="button" class="btn btn-light border" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn-custom-primary">Record Collection</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- REJECT MODAL -->
<div class="modal fade" id="rejectModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered" style="max-width: 450px;">
        <div class="modal-content border-0 shadow">
            <div class="modal-header border-bottom bg-light">
                <h5 class="modal-title fw-bold text-danger"><i class="fa-solid fa-ban me-2"></i> Reject Specimen Vials</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <form action="/Laboratory/Reject" method="post">
                <input type="hidden" name="sampleId" id="rejectSampleId" />
                <div class="modal-body p-4">
                    <div class="mb-3">
                        <label class="form-label" style="font-size: 13.5px; font-weight: 500;">Rejection Reason <span class="text-danger">*</span></label>
                        <select name="reason" class="form-select" required>
                            <option value="">-- Choose rejection criteria --</option>
                            <option value="Hemolysis">Hemolysed Sample (Red cells lysed)</option>
                            <option value="InadequateVolume">Inadequate Volume (Quantity not sufficient)</option>
                            <option value="IncorrectTube">Incorrect Tube Type (Wrong additive)</option>
                            <option value="Clotted">Clotted Sample (Coagulated whole blood)</option>
                            <option value="Mislabeled">Mislabeled / Unlabeled Vial</option>
                        </select>
                    </div>
                    <div class="mb-1">
                        <label class="form-label" style="font-size: 13.5px; font-weight: 500;">Internal Staff Remarks</label>
                        <textarea name="remarks" class="form-control" rows="3" placeholder="Describe the specimen state (e.g. Clotted sample received, request recall)..."></textarea>
                    </div>
                </div>
                <div class="modal-footer border-top p-3">
                    <button type="button" class="btn btn-light border" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-danger">Confirm Rejection</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function openCollectModal(id, type, order) {
            $('#collectSampleId').val(id);
            $('#collectVialType').val(type);
            $('#collectCaseRef').val(order);
            // Pre-generate a dummy barcode code for fast click-through testing
            var randomBarcode = "BAR-2026-" + Math.floor(100000 + Math.random() * 900000);
            $('#collectBarcodeVal').val(randomBarcode);
            
            var collectModal = new bootstrap.Modal(document.getElementById('collectModal'));
            collectModal.show();
        }

        function openRejectModal(id) {
            $('#rejectSampleId').val(id);
            var rejectModal = new bootstrap.Modal(document.getElementById('rejectModal'));
            rejectModal.show();
        }
    </script>
}
