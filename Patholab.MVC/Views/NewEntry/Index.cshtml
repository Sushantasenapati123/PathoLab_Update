@section Scripts {
    <script>
        // Holds selected items on the UI
        let selectedItems = [];
        let testsList = [];
        
        // Populate standard tests for autocomplete
        @foreach(var t in allTests)
        {
            @:testsList.push({ id: @t.Id, text: "@t.TestName", code: "@t.TestCode", price: @t.Price });
        }

        $(document).ready(function() {
            const isEdit = @(isEditMode ? "true" : "false");
            const orderIdVal = @(isEditMode ? Model.Id : 0);
            const invoiceIdVal = @(isEditMode && invoice != null ? invoice.Id : 0);
            const reportIdVal = @(isEditMode && report != null ? report.Id : 0);

            // Set current datetime for reporting
            const d = new Date();
            d.setMinutes(d.getMinutes() - d.getTimezoneOffset());
            $('#txtReportingDate').val(d.toISOString().slice(0, 16));

            // Load Edit mode items into JS array
            if (isEdit) {
                @if (isEditMode)
                {
                    foreach (var d in Model.OrderDetails)
                    {
                        var type = d.TestId.HasValue ? "test" : "package";
                        var id = d.TestId.HasValue ? d.TestId.Value : d.PackageId.Value;
                        var name = d.TestId.HasValue ? d.TestName : d.PackageName;
                        @:selectedItems.push({ id: @id, name: "@Html.Raw(name)", price: @d.Rate, code: "@(d.TestId.HasValue ? d.TestCode : d.PackageCode)", type: "@type", isCustom: false });
                    }
                }
                recalculateTotals();
            }

            // Sync autocomplete suggestion transfer boxes (Image 2 style)
            $('#testSearchBox').on('input', function() {
                const term = $(this).val().toLowerCase();
                const selectionBlock = $('#testSelectionBlock');
                const searchList = $('#testSearchList');
                const links = $('#testSelectionLinks');

                if (term.length < 1) {
                    selectionBlock.hide();
                    links.attr('style', 'display:none !important;');
                    return;
                }

                searchList.empty();
                const matches = testsList.filter(t => t.text.toLowerCase().includes(term) || t.code.toLowerCase().includes(term));
                if (matches.length === 0) {
                    searchList.append(`<div class="p-2 text-center text-muted" style="font-size: 11px;">No assays matched</div>`);
                } else {
                    matches.slice(0, 20).forEach(item => {
                        searchList.append(`
                            <div class="selection-item" data-id="${item.id}" data-text="${item.text}" data-price="${item.price}" data-code="${item.code}">
                                <strong style="max-width: 140px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap;">${item.text}</strong>
                                <span class="font-monospace text-muted">₹${item.price.toFixed(2)}</span>
                            </div>
                        `);
                    });
                }

                // Render selected items on suggestion panel
                renderTransferSelectedList();

                selectionBlock.css('display', 'flex');
                links.attr('style', 'display:flex !important;');
            });

            // Handle click on suggestions items to select (transfers to right column)
            $(document).on('click', '#testSearchList .selection-item', function() {
                const id = $(this).data('id');
                const text = $(this).data('text');
                const price = parseFloat($(this).data('price'));
                const code = $(this).data('code');

                selectTestItem(id, text, price, code);
                renderTransferSelectedList();
            });

            // Handle click on selected items on transfer panel to remove
            $(document).on('click', '#testSelectedList .selection-item', function() {
                const id = $(this).data('id');
                const type = $(this).data('type') || 'test';

                removeTestItem(id, type);
                renderTransferSelectedList();
            });

            // Close selection panel
            $('#btnCloseSelectionBlock').click(function() {
                $('#testSearchBox').val('');
                $('#testSelectionBlock').hide();
                $('#testSelectionLinks').attr('style', 'display:none !important;');
            });

            function renderTransferSelectedList() {
                const selectedList = $('#testSelectedList');
                selectedList.empty();
                if (selectedItems.length === 0) {
                    selectedList.append(`<div class="p-2 text-center text-muted" style="font-size: 11px;">None selected</div>`);
                } else {
                    selectedItems.forEach(item => {
                        selectedList.append(`
                            <div class="selection-item" data-id="${item.id}" data-type="${item.type}">
                                <strong style="color: #0369a1;">${item.name}</strong>
                                <span class="text-danger fw-bold">X</span>
                            </div>
                        `);
                    });
                }
            }

            // Datalist double-click or Enter to select referred doctor
            $('#txtDoctorName').on('keydown', function(e) {
                if (e.key === 'Enter') {
                    const val = $(this).val().trim().toLowerCase();
                    const option = $('#doctorList option').filter(function() {
                        return $(this).val().trim().toLowerCase() === val;
                    });
                    if (option.length > 0) {
                        $('#hdnDoctorId').val(option.attr('data-id'));
                        $(this).blur();
                    }
                }
            });

            $('#txtDoctorName').on('input', function() {
                const val = $(this).val().trim().toLowerCase();
