        // Search test selections
        function selectTestItem(id, name, price, code) {
            $('#testSearchBox').val('');
            
            // Check duplicates
            if (selectedItems.some(i => i.id === id && i.type === 'test')) {
                return;
            }

            selectedItems.push({ id: id, name: name, price: price, code: code, type: 'test', isCustom: false });
            renderSelectedTestsTable();
        }

        function addPackageDirectly(id, name, price, code) {
            $('#modalPackage').modal('hide');
            
            if (selectedItems.some(i => i.id === id && i.type === 'package')) {
                return;
            }

            selectedItems.push({ id: id, name: name, price: price, code: code, type: 'package', isCustom: false });
            renderSelectedTestsTable();
        }

        // Render main selected tests table list
        function renderSelectedTestsTable() {
            const tbody = $('#tblSelectedTests tbody');
            $('#trEmptyTests').remove();

            selectedItems.forEach(item => {
                if (tbody.find(`tr[data-item-id="${item.id}"][data-type="${item.type}"]`).length === 0) {
                    tbody.append(`
                        <tr data-item-id="${item.id}" data-type="${item.type}" class="test-pending">
                            <td style="text-align: center;">
                                <button class="btn btn-sm btn-link text-danger p-0" onclick="removeTestItem(${item.id}, '${item.type}')"><i class="fa-solid fa-trash-can"></i></button>
                            </td>
                            <td style="text-align: center;">
                                <span class="text-muted" style="font-size: 11px; font-weight: bold;">Save first</span>
                            </td>
                            <td style="text-align: center;">
                                <input type="checkbox" class="chk-print-report" checked />
                            </td>
                            <td>
                                <strong>${item.name}</strong>
                            </td>
                            <td style="text-align: right;" class="font-monospace price-cell">
                                <span class="price-editable" data-val="${item.price}">${item.price.toFixed(2)}</span>
                            </td>
                        </tr>
                    `);
                }
            });

            recalculateTotals();
        }

        function removeTestItem(id, type) {
            selectedItems = selectedItems.filter(i => !(i.id === id && i.type === type));
            $(`#tblSelectedTests tbody tr[data-item-id="${id}"][data-type="${type}"]`).remove();

            if (selectedItems.length === 0) {
                $('#tblSelectedTests tbody').append(`
                    <tr id="trEmptyTests">
                        <td colspan="5" class="text-center py-3 text-muted" style="font-style: italic;">
                            No tests selected. Search above to add tests.
                        </td>
                    </tr>
                `);
            }
            recalculateTotals();
        }

        function calculateGross() {
            let sum = 0;
            $('#tblSelectedTests tbody tr').each(function() {
                const val = parseFloat($(this).find('.price-editable').text()) || 0;
                sum += val;
            });
            return sum;
        }

        function recalculateTotals() {
            const gross = calculateGross();
            const disc = parseFloat($('#txtDiscountAmount').val()) || 0;
            const outs = parseFloat($('#txtOutsFee').val()) || 0;

            const net = gross - disc + outs;
            const paid = parseFloat($('#lblPaid').text()) || 0;
            const balance = net - paid;

            $('#lblSubtotal').text(gross.toFixed(2));
            $('#lblTotalAmount').text(net.toFixed(2));
            $('#lblBalance').text((balance < 0 ? 0 : balance).toFixed(2));
        }

        // Toggle Right side Report workspace visibility
        function toggleReportPanel(show) {
            if (show) {
                $('#reportWorkspacePlaceholder').addClass('d-none');
                $('#reportActiveWorkspace').removeClass('d-none').attr('style', 'display: flex !important;');
            } else {
                $('#reportWorkspacePlaceholder').removeClass('d-none');
                $('#reportActiveWorkspace').addClass('d-none').attr('style', 'display: none !important;');
            }
        }

        // Retrieve parameters from REST API
        function loadReportWorkspace(sampleId, testName) {
            $('#hdnActiveSampleId').val(sampleId);
            $('#txtReportHeading').val(testName.toUpperCase());

            Swal.fire({
                title: 'Loading Parameters...',
                allowOutsideClick: false,
                didOpen: () => { Swal.showLoading(); }
            });

            $.getJSON('/NewEntry/GetResults', { sampleId: sampleId }, function(res) {
                Swal.close();
                if (res.success) {
                    const tbody = $('#tblReportParams tbody');
                    tbody.empty();

                    res.data.forEach(r => {
                        tbody.append(`
                            <tr data-param-id="${r.testParameterId}" data-param-code="${r.parameterCode.toUpperCase()}">
                                <td style="text-align: center;"><input type="checkbox" checked /></td>
                                <td class="fw-bold" style="color: #0f3d5f;">${r.parameterName}</td>
                                <td><span class="badge bg-secondary" style="font-size: 10px;">${r.specimen || 'Serum'}</span></td>
                                <td>
                                    <input type="text" class="input-result-desktop text-center" value="${r.resultValue || ''}" placeholder="Value..." />
                                </td>
                                <td class="font-monospace text-muted" style="font-size: 11px;">${r.unit || ''}</td>
                                <td class="font-monospace text-muted" style="font-size: 11px;">${r.referenceRange || 'N/A'}</td>
                                <td style="text-align: center; color: #555;">0.0</td>
                                <td style="text-align: center; color: #555;">0.0</td>
                                <td style="text-align: center;" class="font-monospace text-muted">${r.testParameterId}</td>
                            </tr>
                        `);
                    });

                    toggleReportPanel(true);
                } else {
                    Swal.fire('Error', 'Failed to retrieve test parameters.', 'error');
                }
            });
        }

        // JS Formulas calculation (Liver & Kidney functions)
        function runAutoCalculationFormulas() {
            const params = {};
            $('#tblReportParams tbody tr').each(function() {
                const code = $(this).data('param-code');
                const val = parseFloat($(this).find('.input-result-desktop').val()) || 0;
                if (code) {
                    params[code] = { val: val, el: $(this).find('.input-result-desktop') };
                }
            });

            // 1. Indirect Bilirubin = Total Bilirubin - Direct Bilirubin
            if (params['TOTAL_BILIRUBIN'] && params['DIRECT_BILIRUBIN'] && params['INDIRECT_BILIRUBIN']) {
                const total = params['TOTAL_BILIRUBIN'].val;
                const direct = params['DIRECT_BILIRUBIN'].val;
                const indirect = total - direct;
                if (indirect >= 0) {
                    params['INDIRECT_BILIRUBIN'].el.val(indirect.toFixed(2));
                }
            }

            // 2. Globulin = Total Protein - Albumin
            if (params['TOTAL_PROTEIN'] && params['ALBUMIN'] && params['GLOBULIN']) {
                const tp = params['TOTAL_PROTEIN'].val;
                const alb = params['ALBUMIN'].val;
                const glob = tp - alb;
                if (glob >= 0) {
                    params['GLOBULIN'].el.val(glob.toFixed(2));
                }
            }

            // 3. A/G Ratio = Albumin / Globulin
            if (params['ALBUMIN'] && params['GLOBULIN'] && params['AG_RATIO']) {
                const alb = params['ALBUMIN'].val;
                const glob = parseFloat(params['GLOBULIN'].el.val()) || 0;
                if (glob > 0) {
                    const ratio = alb / glob;
                    params['AG_RATIO'].el.val(ratio.toFixed(2));
                }
            }
        }
    </script>
}
