@model Patholab.Shared.DTOs.PatientDto
@{
    ViewData["Title"] = "Edit Patient Profile";
}

<div class="card-custom border-0 shadow-sm max-width-800 mx-auto">
    <div class="card-custom-header">
        <h5 class="card-custom-title"><i class="fa-solid fa-hospital-user text-primary"></i> Edit Patient profile: @Model.PatientCode</h5>
        <a href="/Patients" class="btn btn-light border btn-sm">
            <i class="fa-solid fa-chevron-left me-1"></i> Back to Directory
        </a>
    </div>

    <div class="card-custom-body">
        <form asp-action="Edit" method="post">
            <input type="hidden" asp-for="Id" />
            <input type="hidden" asp-for="PatientCode" />

            <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 border-0" style="font-size: 13.5px; background-color: rgba(239, 68, 68, 0.1); color: #ef4444;"></div>

            <div class="row g-3 mb-4">
                <!-- Personal Info -->
                <div class="col-12"><h6 class="text-muted fw-bold mb-0" style="font-size: 12px; text-transform: uppercase; letter-spacing: 0.5px;">1. Personal Details</h6></div>
                
                <div class="col-md-6">
                    <label class="form-label" style="font-size: 13.5px; font-weight: 500;">First Name <span class="text-danger">*</span></label>
                    <input asp-for="FirstName" class="form-control" required />
                    <span asp-validation-for="FirstName" class="text-danger" style="font-size: 12px;"></span>
                </div>
                
                <div class="col-md-6">
                    <label class="form-label" style="font-size: 13.5px; font-weight: 500;">Last Name <span class="text-danger">*</span></label>
                    <input asp-for="LastName" class="form-control" required />
                    <span asp-validation-for="LastName" class="text-danger" style="font-size: 12px;"></span>
                </div>

                <div class="col-md-6">
                    <label class="form-label" style="font-size: 13.5px; font-weight: 500;">Date of Birth <span class="text-danger">*</span></label>
                    <input asp-for="DateOfBirth" type="date" class="form-control" required />
                    <span asp-validation-for="DateOfBirth" class="text-danger" style="font-size: 12px;"></span>
                </div>

                <div class="col-md-3">
                    <label class="form-label" style="font-size: 13.5px; font-weight: 500;">Gender <span class="text-danger">*</span></label>
                    <select asp-for="Gender" class="form-select" required>
                        <option value="Male">Male</option>
                        <option value="Female">Female</option>
                        <option value="Other">Other</option>
                    </select>
                    <span asp-validation-for="Gender" class="text-danger" style="font-size: 12px;"></span>
                </div>

                <div class="col-md-3">
                    <label class="form-label" style="font-size: 13.5px; font-weight: 500;">Blood Group</label>
                    <select asp-for="BloodGroup" class="form-select">
                        <option value="O+">O+</option>
                        <option value="O-">O-</option>
                        <option value="A+">A+</option>
                        <option value="A-">A-</option>
                        <option value="B+">B+</option>
                        <option value="B-">B-</option>
                        <option value="AB+">AB+</option>
                        <option value="AB-">AB-</option>
                    </select>
                </div>

                <!-- Contact details -->
                <div class="col-12 mt-4"><h6 class="text-muted fw-bold mb-0" style="font-size: 12px; text-transform: uppercase; letter-spacing: 0.5px;">2. Contact Information</h6></div>

                <div class="col-md-6">
                    <label class="form-label" style="font-size: 13.5px; font-weight: 500;">Mobile Number <span class="text-danger">*</span></label>
                    <input asp-for="Mobile" class="form-control" required />
                    <span asp-validation-for="Mobile" class="text-danger" style="font-size: 12px;"></span>
                </div>

                <div class="col-md-6">
                    <label class="form-label" style="font-size: 13.5px; font-weight: 500;">Email Address</label>
                    <input asp-for="Email" class="form-control" type="email" />
                    <span asp-validation-for="Email" class="text-danger" style="font-size: 12px;"></span>
                </div>

                <!-- Location details -->
                <div class="col-12 mt-4"><h6 class="text-muted fw-bold mb-0" style="font-size: 12px; text-transform: uppercase; letter-spacing: 0.5px;">3. Address & Location</h6></div>

                <div class="col-12">
                    <label class="form-label" style="font-size: 13.5px; font-weight: 500;">Street Address</label>
                    <input asp-for="Address" class="form-control" />
                </div>

                <div class="col-md-4">
                    <label class="form-label" style="font-size: 13.5px; font-weight: 500;">City</label>
                    <input asp-for="City" class="form-control" />
                </div>

                <div class="col-md-4">
                    <label class="form-label" style="font-size: 13.5px; font-weight: 500;">State</label>
                    <input asp-for="State" class="form-control" />
                </div>

                <div class="col-md-4">
                    <label class="form-label" style="font-size: 13.5px; font-weight: 500;">Pincode</label>
                    <input asp-for="Pincode" class="form-control" />
                </div>
            </div>

            <hr class="my-4" />

            <div class="d-flex justify-content-end gap-2">
                <a href="/Patients" class="btn btn-light border">Cancel</a>
                <button type="submit" class="btn-custom-primary">Update Profile Settings</button>
            </div>
        </form>
    </div>
</div>
