@model Patholab.Shared.DTOs.PatientDto
@{
    ViewData["Title"] = "Patient Profile Details";
    var history = ViewBag.History as List<Patholab.Shared.DTOs.OrderDto> ?? new List<Patholab.Shared.DTOs.OrderDto>();
}

<div class="row g-4">
    <!-- Demographic Card -->
    <div class="col-lg-4">
        <div class="card-custom border-0 shadow-sm h-100">
            <div class="card-custom-header">
                <h5 class="card-custom-title"><i class="fa-solid fa-address-card text-primary"></i> Patient Demographics</h5>
            </div>
            <div class="card-custom-body">
                <div class="text-center mb-4">
                    <div class="d-inline-flex align-items-center justify-content-center rounded-circle bg-light mb-3" style="width: 80px; height: 80px;">
                        <i class="fa-solid fa-user-injured fs-1 text-primary"></i>
                    </div>
                    <h5 class="fw-bold text-dark mb-1">@Model.FirstName @Model.LastName</h5>
                    <span class="badge bg-primary">@Model.PatientCode</span>
                </div>

                <ul class="list-group list-group-flush" style="font-size: 13.5px;">
                    <li class="list-group-item d-flex justify-content-between px-0 py-3">
                        <span class="text-muted">Age / Gender:</span>
                        <span class="fw-bold">@Model.Age Years / @Model.Gender</span>
                    </li>
                    <li class="list-group-item d-flex justify-content-between px-0 py-3">
                        <span class="text-muted">Blood Group:</span>
                        <span class="badge bg-danger bg-opacity-10 text-danger">@Model.BloodGroup</span>
                    </li>
                    <li class="list-group-item d-flex justify-content-between px-0 py-3">
                        <span class="text-muted">Mobile Number:</span>
                        <span class="fw-bold">@Model.Mobile</span>
                    </li>
                    <li class="list-group-item d-flex justify-content-between px-0 py-3">
                        <span class="text-muted">Email:</span>
                        <span class="fw-bold">@(Model.Email ?? "N/A")</span>
                    </li>
                    <li class="list-group-item px-0 py-3 border-bottom-0">
                        <span class="text-muted d-block mb-1">Billing Address:</span>
                        <div class="fw-medium text-dark" style="line-height: 1.5;">
                            @Model.Address<br />
                            @Model.City, @Model.State - @Model.Pincode
                        </div>
                    </li>
                </ul>

                <hr class="my-4" />
                <div class="d-grid gap-2">
                    <a href="/Orders/Create?patientId=@Model.Id" class="btn-custom-primary text-center text-decoration-none">
                        <i class="fa-solid fa-cart-plus me-1"></i> Book New Diagnostic Order
                    </a>
                    <a href="/Patients/Edit/@Model.Id" class="btn btn-light border">
                        <i class="fa-solid fa-pen-to-square me-1"></i> Edit Profile
                    </a>
                </div>
            </div>
        </div>
    </div>

    <!-- Timeline / History Card -->
    <div class="col-lg-8">
        <div class="card-custom border-0 shadow-sm h-100">
            <div class="card-custom-header">
                <h5 class="card-custom-title"><i class="fa-solid fa-clock-rotate-left text-success"></i> Clinical Case History</h5>
            </div>
            <div class="card-custom-body p-0">
                <div class="table-responsive">
                    <table class="table table-hover align-middle m-0" style="font-size: 13.5px;">
                        <thead class="table-light">
                            <tr>
                                <th class="ps-4">Order Number</th>
                                <th>Booking Date</th>
                                <th>Test Booked</th>
                                <th>Gross Cost</th>
                                <th>Case Status</th>
                                <th class="text-end pe-4">Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (history.Count == 0)
                            {
                                <tr>
                                    <td colspan="6" class="text-center py-5 text-muted">
                                        <i class="fa-solid fa-folder-open d-block fs-3 mb-2"></i>
                                        No billing cases or diagnostic reports recorded for this patient.
                                    </td>
                                </tr>
                            }
                            else
                            {
                                foreach (var order in history)
                                {
                                    <tr>
                                        <td class="ps-4 fw-semibold text-primary">@order.OrderNumber</td>
                                        <td>@order.OrderDate.ToString("dd-MMM-yyyy hh:mm tt")</td>
                                        <td>
                                            <div style="max-width: 220px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap;">
                                                @string.Join(", ", order.OrderDetails.Select(d => d.TestName))
                                            </div>
                                        </td>
                                        <td class="fw-bold">@order.NetAmount.ToString("C")</td>
                                        <td>
                                            @{
                                                var stBadge = "bg-secondary";
                                                if (order.OrderStatus == Patholab.Domain.Enums.OrderStatus.Registered) stBadge = "bg-primary bg-opacity-10 text-primary";
                                                else if (order.OrderStatus == Patholab.Domain.Enums.OrderStatus.Published) stBadge = "bg-success bg-opacity-10 text-success";
                                                else if (order.OrderStatus == Patholab.Domain.Enums.OrderStatus.Cancelled) stBadge = "bg-danger bg-opacity-10 text-danger";
                                                else stBadge = "bg-warning bg-opacity-10 text-warning";
                                            }
                                            <span class="badge @stBadge" style="font-size: 11px;">@order.OrderStatus</span>
                                        </td>
                                        <td class="text-end pe-4">
                                            <a href="/Orders/Details/@order.Id" class="btn btn-sm btn-light border py-1">
                                                <i class="fa-solid fa-eye me-1 text-muted"></i> Case File
                                            </a>
                                        </td>
                                    </tr>
                                }
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>
