@model Patholab.Shared.DTOs.CreatePaymentRequest
@{
    ViewData["Title"] = "Collect Balance Payment";
    var invoice = ViewBag.Invoice as Patholab.Shared.DTOs.InvoiceDto;
}

<div class="card-custom border-0 shadow-sm max-width-600 mx-auto">
    <div class="card-custom-header">
        <h5 class="card-custom-title"><i class="fa-solid fa-hand-holding-dollar text-primary"></i> Collect Balance Payment</h5>
        <a href="/Billing/Invoices" class="btn btn-light border btn-sm">
            <i class="fa-solid fa-chevron-left me-1"></i> Back to Ledger
        </a>
    </div>

    <div class="card-custom-body">
        <!-- Invoice Summary Box -->
        <div class="border rounded p-3 mb-4 bg-light bg-opacity-35" style="font-size: 13.5px;">
            <div class="row g-2">
                <div class="col-sm-6">
                    <span class="text-muted d-block" style="font-size: 11px;">Invoice Number</span>
                    <strong>@invoice?.InvoiceNumber</strong>
                </div>
                <div class="col-sm-6">
                    <span class="text-muted d-block" style="font-size: 11px;">Patient Name</span>
                    <strong>@invoice?.PatientName</strong>
                </div>
                <div class="col-sm-6 mt-3">
                    <span class="text-muted d-block" style="font-size: 11px;">Total Net Amount</span>
                    <strong>@invoice?.NetAmount.ToString("C")</strong>
                </div>
                <div class="col-sm-6 mt-3">
                    <span class="text-muted d-block" style="font-size: 11px;">Remaining Balance</span>
                    <strong class="text-danger">@invoice?.DueAmount.ToString("C")</strong>
                </div>
            </div>
        </div>

        <form asp-action="Collect" method="post">
            <input type="hidden" asp-for="InvoiceId" />
            <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 border-0" style="font-size: 13.5px; background-color: rgba(239, 68, 68, 0.1); color: #ef4444;"></div>

            <div class="mb-3">
                <label class="form-label" style="font-size: 13.5px; font-weight: 500;">Amount to Collect <span class="text-danger">*</span></label>
                <div class="input-group">
                    <span class="input-group-text">$</span>
                    <input asp-for="Amount" type="number" step="0.01" max="@invoice?.DueAmount" class="form-control fw-bold text-dark" required />
                </div>
                <span asp-validation-for="Amount" class="text-danger" style="font-size: 12px;"></span>
            </div>

            <div class="mb-3">
                <label class="form-label" style="font-size: 13.5px; font-weight: 500;">Payment Mode</label>
                <select asp-for="PaymentMode" class="form-select" id="payModeSel">
                    <option value="UPI">UPI / Digital Wallet</option>
                    <option value="Card">Credit / Debit Card</option>
                    <option value="Cash">Cash Deposit</option>
                </select>
            </div>

            <div class="mb-3" id="transRefDiv">
                <label class="form-label" style="font-size: 13.5px; font-weight: 500;">Transaction Ref ID</label>
                <input asp-for="TransactionReference" class="form-control" placeholder="Enter transaction reference ID..." />
            </div>

            <hr class="my-4" />

            <div class="d-flex justify-content-end gap-2">
                <a href="/Billing/Invoices" class="btn btn-light border">Cancel</a>
                <button type="submit" class="btn-custom-primary">Record Payment</button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function() {
            $('#payModeSel').change(function() {
                if ($(this).val() === 'Cash') {
                    $('#transRefDiv').hide();
                } else {
                    $('#transRefDiv').show();
                }
            });
            $('#payModeSel').trigger('change');
        });
    </script>
}
