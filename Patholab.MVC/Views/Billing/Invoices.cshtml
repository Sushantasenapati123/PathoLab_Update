@model Patholab.Shared.Models.PagedResult<Patholab.Shared.DTOs.InvoiceDto>
@{
    ViewData["Title"] = "Lab Invoices Ledger";
    var search = ViewBag.Search as string;
}

<div class="card-custom border-0 shadow-sm">
    <div class="card-custom-header">
        <h5 class="card-custom-title"><i class="fa-solid fa-file-invoice-dollar text-primary"></i> Billing Invoices Ledger</h5>
        <a href="/Billing/Payments" class="btn btn-outline-primary btn-sm">
            <i class="fa-solid fa-list me-1"></i> View Payments History
        </a>
    </div>

    <div class="card-custom-body">
        <form action="/Billing/Invoices" method="get" class="mb-4">
            <div class="row g-2">
                <div class="col-md-5">
                    <div class="input-group">
                        <span class="input-group-text bg-white border-end-0 text-muted"><i class="fa-solid fa-magnifying-glass"></i></span>
                        <input type="text" name="search" class="form-control border-start-0 ps-0" placeholder="Search by Invoice #, Patient name or order..." value="@search" />
                    </div>
                </div>
                <div class="col-md-2">
                    <button type="submit" class="btn btn-light border w-100">Filter Ledger</button>
                </div>
            </div>
        </form>

        <div class="table-responsive">
            <table class="table table-hover align-middle table-custom m-0">
                <thead>
                    <tr>
                        <th>Invoice Number</th>
                        <th>Order Number</th>
                        <th>Patient Name</th>
                        <th>Invoice Date</th>
                        <th>Gross Total</th>
                        <th>Net Total</th>
                        <th>Settled Amount</th>
                        <th>Outstanding Due</th>
                        <th>Invoice Status</th>
                        <th class="text-end">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var inv in Model.Items)
                    {
                        <tr>
                            <td class="fw-semibold text-primary">@inv.InvoiceNumber</td>
                            <td class="fw-bold">@inv.OrderNumber</td>
                            <td class="fw-bold text-dark">@inv.PatientName</td>
                            <td>@inv.InvoiceDate.ToString("dd-MMM-yyyy")</td>
                            <td>@inv.GrossAmount.ToString("C")</td>
                            <td class="fw-bold text-dark">@inv.NetAmount.ToString("C")</td>
                            <td class="text-success fw-bold">@inv.PaidAmount.ToString("C")</td>
                            <td class="text-danger fw-bold">@inv.DueAmount.ToString("C")</td>
                            <td>
                                @{
                                    var statBadge = "bg-secondary";
                                    if (inv.InvoiceStatus == Patholab.Domain.Enums.InvoiceStatus.Paid) statBadge = "bg-success bg-opacity-10 text-success";
                                    else if (inv.InvoiceStatus == Patholab.Domain.Enums.InvoiceStatus.PartiallyPaid) statBadge = "bg-warning bg-opacity-10 text-warning";
                                    else statBadge = "bg-danger bg-opacity-10 text-danger";
                                }
                                <span class="badge @statBadge" style="font-size: 11px;">@inv.InvoiceStatus</span>
                            </td>
                            <td class="text-end">
                                @if (inv.DueAmount > 0)
                                {
                                    <a href="/Billing/Collect?invoiceId=@inv.Id" class="btn btn-sm btn-warning text-dark px-3 py-1">
                                        <i class="fa-solid fa-hand-holding-dollar me-1"></i> Collect
                                    </a>
                                }
                                else
                                {
                                    <span class="text-muted" style="font-size: 12.5px;">Settled</span>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
