@model Patholab.Shared.DTOs.TestDto
@{
    ViewData["Title"] = "Configure Assay";
    var depts = ViewBag.Departments as SelectList;
    var types = ViewBag.SampleTypes as SelectList;
}

<div class="card-custom border-0 shadow-sm max-width-700 mx-auto">
    <div class="card-custom-header">
        <h5 class="card-custom-title"><i class="fa-solid fa-flask text-primary"></i> Configure Diagnostic Assay</h5>
        <a href="/Tests" class="btn btn-light border btn-sm">
            <i class="fa-solid fa-chevron-left me-1"></i> Back to Setup
        </a>
    </div>

    <div class="card-custom-body">
        <form asp-action="Create" method="post">
            <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 border-0" style="font-size: 13.5px; background-color: rgba(239, 68, 68, 0.1); color: #ef4444;"></div>

            <div class="row g-3">
                <div class="col-md-6">
                    <label class="form-label" style="font-size: 13px; font-weight: 500;">Test Name <span class="text-danger">*</span></label>
                    <input asp-for="TestName" class="form-control form-control-sm" placeholder="e.g. Complete Blood Count" required />
                    <span asp-validation-for="TestName" class="text-danger" style="font-size: 12px;"></span>
                </div>
                <div class="col-md-6">
                    <label class="form-label" style="font-size: 13px; font-weight: 500;">Unique Test Code <span class="text-danger">*</span></label>
                    <input asp-for="TestCode" class="form-control form-control-sm" placeholder="e.g. CBC" required />
                    <span asp-validation-for="TestCode" class="text-danger" style="font-size: 12px;"></span>
                </div>

                <div class="col-md-6">
                    <label class="form-label" style="font-size: 13px; font-weight: 500;">Assigned Lab Department <span class="text-danger">*</span></label>
                    <select asp-for="DepartmentId" class="form-select form-select-sm" asp-items="depts" required>
                        <option value="">-- Choose department --</option>
                    </select>
                </div>
                <div class="col-md-6">
                    <label class="form-label" style="font-size: 13px; font-weight: 500;">Required Specimen Type <span class="text-danger">*</span></label>
                    <select asp-for="SampleTypeId" class="form-select form-select-sm" asp-items="types" required>
                        <option value="">-- Choose sample type --</option>
                    </select>
                </div>

                <div class="col-md-4">
                    <label class="form-label" style="font-size: 13px; font-weight: 500;">Test Type</label>
                    <select asp-for="TestType" class="form-select form-select-sm">
                        <option value="Single">Single Value</option>
                        <option value="Profile">Profile (Multi-value)</option>
                    </select>
                </div>
                <div class="col-md-4">
                    <label class="form-label" style="font-size: 13px; font-weight: 500;">Turnaround Time (Minutes) <span class="text-danger">*</span></label>
                    <input asp-for="TATMinutes" type="number" class="form-control form-control-sm" required />
                    <span asp-validation-for="TATMinutes" class="text-danger" style="font-size: 12px;"></span>
                </div>
                <div class="col-md-4">
                    <label class="form-label" style="font-size: 13px; font-weight: 500;">Standard Price ($) <span class="text-danger">*</span></label>
                    <input asp-for="Price" type="number" step="0.01" class="form-control form-control-sm" required />
                    <span asp-validation-for="Price" class="text-danger" style="font-size: 12px;"></span>
                </div>
            </div>

            <hr class="my-4" />

            <div class="d-flex justify-content-end gap-2">
                <a href="/Tests" class="btn btn-light border">Cancel</a>
                <button type="submit" class="btn-custom-primary">Configure Assay Profile</button>
            </div>
        </form>
    </div>
</div>
