@model Patholab.Shared.Models.PagedResult<Patholab.Shared.DTOs.ReportDto>
@{
    ViewData["Title"] = "Published Diagnostic Reports";
    var search = ViewBag.Search as string;
}

<div class="card-custom border-0 shadow-sm">
    <div class="card-custom-header">
        <h5 class="card-custom-title"><i class="fa-solid fa-file-medical text-primary"></i> Patient Diagnostic Reports</h5>
    </div>

    <div class="card-custom-body">
        <!-- Search filter form -->
        <form action="/Reports" method="get" class="mb-4">
            <div class="row g-2">
                <div class="col-md-5">
                    <div class="input-group">
                        <span class="input-group-text bg-white border-end-0 text-muted"><i class="fa-solid fa-magnifying-glass"></i></span>
                        <input type="text" name="search" class="form-control border-start-0 ps-0" placeholder="Search by Report #, Patient Code, or name..." value="@search" />
                    </div>
                </div>
                <div class="col-md-2">
                    <button type="submit" class="btn btn-light border w-100">Filter Reports</button>
                </div>
                @if (!string.IsNullOrEmpty(search))
                {
                    <div class="col-md-2">
                        <a href="/Reports" class="btn btn-link text-muted">Clear Filters</a>
                    </div>
                }
            </div>
        </form>

        <div class="table-responsive">
            <table class="table table-hover align-middle table-custom m-0">
                <thead>
                    <tr>
                        <th>Report Number</th>
                        <th>Order Ref</th>
                        <th>Patient Name</th>
                        <th>Patient Code</th>
                        <th>Sign-off Date</th>
                        <th>Status</th>
                        <th class="text-end">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.Items == null || Model.Items.Count == 0)
                    {
                        <tr>
                            <td colspan="7" class="text-center py-5 text-muted">
                                <i class="fa-solid fa-file-excel fs-2 d-block mb-2"></i>
                                No published reports found matching details.
                            </td>
                        </tr>
                    }
                    else
                    {
                        foreach (var r in Model.Items)
                        {
                            <tr>
                                <td class="fw-semibold text-primary">@r.ReportNumber</td>
                                <td class="fw-bold">@r.OrderNumber</td>
                                <td class="fw-bold text-dark">@r.PatientName</td>
                                <td>@r.PatientCode</td>
                                <td>@r.ReportDate.ToString("dd-MMM-yyyy hh:mm tt")</td>
                                <td>
                                    @{
                                        var badge = "bg-secondary";
                                        if (r.ReportStatus == Patholab.Domain.Enums.ReportStatus.Published) badge = "bg-success bg-opacity-10 text-success";
                                        else if (r.ReportStatus == Patholab.Domain.Enums.ReportStatus.Verified) badge = "bg-info bg-opacity-10 text-info";
                                        else badge = "bg-warning bg-opacity-10 text-warning";
                                    }
                                    <span class="badge @badge" style="font-size: 11.5px; font-weight: 600;">@r.ReportStatus</span>
                                </td>
                                <td class="text-end">
                                    <div class="d-inline-flex gap-2">
                                        @if (r.ReportStatus == Patholab.Domain.Enums.ReportStatus.Published)
                                        {
                                            <a href="/Reports/Download/@r.Id" class="btn btn-sm btn-light border text-success">
                                                <i class="fa-solid fa-file-pdf me-1"></i> Print / PDF
                                            </a>
                                        }
                                        else
                                        {
                                            <span class="text-muted" style="font-size: 12.5px;">Awaiting Sign-off</span>
                                        }
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>

        @if (Model.TotalPages > 1)
        {
            <nav class="mt-4">
                <ul class="pagination justify-content-center m-0">
                    <li class="page-item @(Model.PageNumber <= 1 ? "disabled" : "")">
                        <a class="page-link" href="/Reports?pageNumber=@(Model.PageNumber - 1)&search=@search">Previous</a>
                    </li>
                    @for (int i = 1; i <= Model.TotalPages; i++)
                    {
                        <li class="page-item @(Model.PageNumber == i ? "active" : "")">
                            <a class="page-link" href="/Reports?pageNumber=@i&search=@search">@i</a>
                        </li>
                    }
                    <li class="page-item @(Model.PageNumber >= Model.TotalPages ? "disabled" : "")">
                        <a class="page-link" href="/Reports?pageNumber=@(Model.PageNumber + 1)&search=@search">Next</a>
                    </li>
                </ul>
            </nav>
        }
    </div>
</div>
