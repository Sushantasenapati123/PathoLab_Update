@model Patholab.Shared.DTOs.CreateOrderRequest
@{
    ViewData["Title"] = "Diagnostic Case Booking";
    var patients = ViewBag.Patients as List<SelectListItem> ?? new List<SelectListItem>();
    var doctors = ViewBag.Doctors as List<SelectListItem> ?? new List<SelectListItem>();
    var tests = ViewBag.Tests as List<Patholab.Shared.DTOs.TestDto> ?? new List<Patholab.Shared.DTOs.TestDto>();
    var packages = ViewBag.Packages as List<Patholab.Shared.DTOs.TestPackageDto> ?? new List<Patholab.Shared.DTOs.TestPackageDto>();
}

<div class="card-custom border-0 shadow-sm max-width-1000 mx-auto">
    <div class="card-custom-header">
        <h5 class="card-custom-title"><i class="fa-solid fa-cart-plus text-primary"></i> Book Diagnostics Case</h5>
        <a href="/Orders" class="btn btn-light border btn-sm">
            <i class="fa-solid fa-chevron-left me-1"></i> Back to History
        </a>
    </div>

    <div class="card-custom-body">
        <form asp-action="Create" method="post" id="bookingForm">
            <div class="row g-4">
                
                <!-- Client Profiles selection -->
                <div class="col-md-6">
                    <label class="form-label" style="font-size: 13.5px; font-weight: 500;">Select Patient <span class="text-danger">*</span></label>
                    <select asp-for="PatientId" class="form-select select2-enable" asp-items="patients" required>
                        <option value="">-- Choose registered patient profile --</option>
                    </select>
                    <div class="mt-2" style="font-size: 12px;">
                        Not registered? <a href="/Patients/Create" target="_blank" class="text-decoration-none fw-semibold">Register patient profile <i class="fa-solid fa-up-right-from-square"></i></a>
                    </div>
                </div>

                <div class="col-md-6">
                    <label class="form-label" style="font-size: 13.5px; font-weight: 500;">Referral Doctor <span class="text-danger">*</span></label>
                    <select asp-for="DoctorId" class="form-select select2-enable" asp-items="doctors">
                        <option value="">-- Self Referral (No doctor referral) --</option>
                    </select>
                </div>

                <hr class="my-4" />

                <!-- Select Assays Column -->
                <div class="col-md-7">
                    <h6 class="text-muted fw-bold mb-3" style="font-size: 12px; text-transform: uppercase; letter-spacing: 0.5px;">1. Select Diagnostic Assays</h6>

                    <!-- Packages List -->
                    <div class="mb-4">
                        <div class="fw-bold mb-2 text-dark" style="font-size: 13.5px;">Test Packages (Profiles)</div>
                        <div class="row g-3">
                            @foreach (var pkg in packages)
                            {
                                <div class="col-12">
                                    <div class="border rounded p-3 d-flex align-items-start gap-3 bg-light bg-opacity-30">
                                        <input type="checkbox" name="TestPackageIds" value="@pkg.Id" class="form-check-input mt-1 pkg-checkbox" data-price="@pkg.PackagePrice" />
                                        <div class="flex-grow-1">
                                            <div class="fw-bold text-dark" style="font-size: 14.5px;">@pkg.PackageName</div>
                                            <span class="text-muted d-block" style="font-size: 11.5px; line-height: 1.4;">@pkg.Description</span>
                                            <span class="badge bg-success bg-opacity-10 text-success mt-2" style="font-size: 10px;">Includes CBC, LFT, KFT</span>
                                        </div>
                                        <div class="text-end">
                                            <span class="fw-bold text-primary d-block" style="font-size: 16px;">@pkg.PackagePrice.ToString("C")</span>
                                            <span class="text-decoration-line-through text-muted" style="font-size: 11.5px;">@pkg.OriginalPrice.ToString("C")</span>
                                        </div>
                                    </div>
                                </div>
                            }
                        </div>
                    </div>

                    <!-- Individual Tests -->
                    <div>
                        <div class="fw-bold mb-2 text-dark" style="font-size: 13.5px;">Individual Standard Assays</div>
                        <div class="row g-2" style="max-height: 320px; overflow-y: auto; padding-right: 5px;">
                            @foreach (var t in tests)
                            {
                                <div class="col-12 col-sm-6">
                                    <div class="border rounded p-2 d-flex align-items-center justify-content-between">
                                        <div class="d-flex align-items-center gap-2">
                                            <input type="checkbox" name="TestIds" value="@t.Id" class="form-check-input test-checkbox" data-price="@t.Price" />
                                            <div>
                                                <span class="fw-medium text-dark d-block" style="font-size: 13px;">@t.TestName</span>
                                                <span class="text-muted" style="font-size: 10.5px;">Code: @t.TestCode</span>
                                            </div>
                                        </div>
                                        <span class="fw-bold text-muted" style="font-size: 13px;">@t.Price.ToString("C")</span>
                                    </div>
                                </div>
                            }
                        </div>
                    </div>
                </div>

                <!-- Billing & Invoicing Summary Column -->
                <div class="col-md-5">
                    <div class="border rounded p-4 bg-light bg-opacity-40">
                        <h6 class="text-muted fw-bold mb-3" style="font-size: 12px; text-transform: uppercase; letter-spacing: 0.5px;">2. Billing & Settlement</h6>

                        <div class="d-flex justify-content-between py-2 border-bottom">
                            <span class="text-muted">Total Gross Amount:</span>
                            <span class="fw-semibold text-dark" id="lblGross">$0.00</span>
                        </div>
                        
                        <div class="d-flex justify-content-between py-2 border-bottom">
                            <span class="text-muted">Package Discounts:</span>
                            <span class="text-success fw-semibold" id="lblDiscount">-$0.00</span>
                            <input type="hidden" asp-for="DiscountAmount" id="txtDiscount" value="0" />
                        </div>

                        <div class="d-flex justify-content-between py-3 border-bottom align-items-center">
                            <span class="text-muted fw-bold">Net Payable:</span>
                            <span class="fw-bold text-primary" style="font-size: 20px;" id="lblNet">$0.00</span>
                        </div>

                        <!-- Payment Collection Input -->
                        <div class="mt-4">
                            <label class="form-label" style="font-size: 13.5px; font-weight: 500;">Amount Received (Settlement) <span class="text-danger">*</span></label>
                            <div class="input-group">
                                <span class="input-group-text">$</span>
                                <input asp-for="PaidAmount" type="number" step="0.01" class="form-control fw-bold text-dark" id="txtPaid" value="0.00" required />
                            </div>
                        </div>

                        <div class="mt-3">
                            <label class="form-label" style="font-size: 13.5px; font-weight: 500;">Payment Mode</label>
                            <select asp-for="PaymentMode" class="form-select" id="ddlPayMode">
                                <option value="UPI">UPI / Digital Wallet</option>
                                <option value="Card">Credit / Debit Card</option>
                                <option value="Cash">Cash Deposit</option>
                            </select>
                        </div>

                        <div class="mt-3" id="transRefDiv">
                            <label class="form-label" style="font-size: 13.5px; font-weight: 500;">Transaction Ref ID</label>
                            <input asp-for="TransactionReference" class="form-control" placeholder="UPI transaction ID / Card transaction hash" />
                        </div>

                        <div class="d-flex justify-content-between py-2 mt-3 text-muted" style="font-size: 12.5px;">
                            <span>Balance Due (Outstanding):</span>
                            <span class="fw-bold text-danger" id="lblDue">$0.00</span>
                        </div>

                        <div class="mt-4">
                            <button type="submit" class="btn-custom-primary w-100 py-2.5">
                                <i class="fa-solid fa-cash-register me-1"></i> Finalize Settlement & Book
                            </button>
                        </div>
                    </div>
                </div>

            </div>
        </form>
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function() {
            // Monitor checkbox changes to recompute
            $('.test-checkbox, .pkg-checkbox').change(function() {
                recalculate();
            });

            $('#txtPaid').on('input', function() {
                recalculate();
            });

            $('#ddlPayMode').change(function() {
                var val = $(this).val();
                if (val === 'Cash') {
                    $('#transRefDiv').hide();
                } else {
                    $('#transRefDiv').show();
                }
            });

            // Trigger initial state
            $('#ddlPayMode').trigger('change');

            function recalculate() {
                var gross = 0;
                var discount = 0;
                
                // Add individual tests
                $('.test-checkbox:checked').each(function() {
                    gross += parseFloat($(this).data('price'));
                });

                // Add packages
                $('.pkg-checkbox:checked').each(function() {
                    gross += parseFloat($(this).data('price'));
                });

                // Package discount logic can be simulated here
                // For demo simplicity, let's keep net = gross, and let users type custom discount if they want,
                // or keep discount = 0.
                var net = gross - discount;
                var paid = parseFloat($('#txtPaid').val()) || 0;
                
                if (paid > net) {
                    paid = net;
                    $('#txtPaid').val(paid.toFixed(2));
                }
                
                var due = net - paid;

                // Update Labels
                $('#lblGross').text('$' + gross.toFixed(2));
                $('#lblDiscount').text('-$' + discount.toFixed(2));
                $('#txtDiscount').val(discount);
                $('#lblNet').text('$' + net.toFixed(2));
                $('#lblDue').text('$' + due.toFixed(2));
            }
        });
    </script>
}
