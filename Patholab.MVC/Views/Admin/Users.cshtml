@model Patholab.Shared.Models.PagedResult<Patholab.Shared.DTOs.UserDto>
@{
    ViewData["Title"] = "Lab User Management";
    var roles = ViewBag.Roles as SelectList;
    var search = ViewBag.Search as string;
}

<div class="card-custom border-0 shadow-sm">
    <div class="card-custom-header">
        <h5 class="card-custom-title"><i class="fa-solid fa-users-gear text-primary"></i> Lab Accounts Management</h5>
        <button class="btn-custom-primary" data-bs-toggle="modal" data-bs-target="#userModal">
            <i class="fa-solid fa-plus me-1"></i> Register Lab User
        </button>
    </div>

    <div class="card-custom-body">
        <form action="/Admin/Users" method="get" class="mb-4">
            <div class="row g-2">
                <div class="col-md-5">
                    <div class="input-group">
                        <span class="input-group-text bg-white border-end-0 text-muted"><i class="fa-solid fa-magnifying-glass"></i></span>
                        <input type="text" name="search" class="form-control border-start-0 ps-0" placeholder="Search by name or username..." value="@search" />
                    </div>
                </div>
                <div class="col-md-2">
                    <button type="submit" class="btn btn-light border w-100">Filter Users</button>
                </div>
            </div>
        </form>

        <div class="table-responsive">
            <table class="table table-hover align-middle table-custom m-0">
                <thead>
                    <tr>
                        <th>Username</th>
                        <th>Full Name</th>
                        <th>Role Designation</th>
                        <th>Email Contact</th>
                        <th>Mobile</th>
                        <th>Status</th>
                        <th>Last Login</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var u in Model.Items)
                    {
                        <tr>
                            <td class="fw-bold text-dark">@u.Username</td>
                            <td>@u.FullName</td>
                            <td><span class="badge bg-primary bg-opacity-10 text-primary">@u.RoleName</span></td>
                            <td>@u.Email</td>
                            <td>@u.Mobile</td>
                            <td>
                                <span class="badge @(u.IsActive ? "bg-success" : "bg-danger")">@(u.IsActive ? "Active" : "Inactive")</span>
                            </td>
                            <td>@(u.LastLoginDate.HasValue ? u.LastLoginDate.Value.ToString("dd-MMM hh:mm tt") : "Never")</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<!-- USER CREATION MODAL -->
<div class="modal fade" id="userModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered" style="max-width: 500px;">
        <div class="modal-content border-0 shadow">
            <div class="modal-header border-bottom bg-light">
                <h5 class="modal-title fw-bold"><i class="fa-solid fa-user-plus text-primary me-2"></i> Register New Staff Account</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <form action="/Admin/CreateUser" method="post">
                <div class="modal-body p-4">
                    <div class="row g-3">
                        <div class="col-md-6">
                            <label class="form-label" style="font-size: 13px; font-weight: 500;">Username <span class="text-danger">*</span></label>
                            <input type="text" name="Username" class="form-control form-control-sm" required placeholder="e.g. jdoe" />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label" style="font-size: 13px; font-weight: 500;">Password <span class="text-danger">*</span></label>
                            <input type="password" name="Password" class="form-control form-control-sm" required placeholder="Min 6 chars" />
                        </div>
                        <div class="col-12">
                            <label class="form-label" style="font-size: 13px; font-weight: 500;">Full Name <span class="text-danger">*</span></label>
                            <input type="text" name="FullName" class="form-control form-control-sm" required placeholder="e.g. John Doe" />
                        </div>
                        <div class="col-12">
                            <label class="form-label" style="font-size: 13px; font-weight: 500;">Select Role <span class="text-danger">*</span></label>
                            <select name="RoleId" class="form-select form-select-sm" asp-items="roles" required>
                                <option value="">-- Choose Role --</option>
                            </select>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label" style="font-size: 13px; font-weight: 500;">Email Address</label>
                            <input type="email" name="Email" class="form-control form-control-sm" placeholder="name@patholab.com" />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label" style="font-size: 13px; font-weight: 500;">Mobile Number</label>
                            <input type="text" name="Mobile" class="form-control form-control-sm" placeholder="10-digit number" />
                        </div>
                    </div>
                </div>
                <div class="modal-footer border-top p-3">
                    <button type="button" class="btn btn-light border" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn-custom-primary">Create Account</button>
                </div>
            </form>
        </div>
    </div>
</div>
